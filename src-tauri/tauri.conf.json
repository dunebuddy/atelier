{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atelier",
  "version": "0.2.21",
  "identifier": "com.paulo.atelier",
  "build": {
    "beforeDevCommand": "node scripts/mcp-junto.mjs debug && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/mcp-junto.mjs release && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "atelier",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/atelier-mcp"
    ],
    "shortDescription": "Gestão pessoal com MCP para agentes",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/ganchos.nsh",
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NkRDMjE1NUNCRERBQzgKUldUSTJyMWNGY0p0bUVCTzMyVm9BRitoMGxVYUZIYUZYMXRDeUdDN3JTVXBmcENGdjhublBCMkwK",
      "endpoints": [
        "https://github.com/dunebuddy/atelier/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "atelier"
        ]
      }
    }
  }
}
